{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper",
  "description": "The paper's version record (Implementation Decision 17; ticket 115): research/paper/paper.json, written only by wayline.paper through the ledger at each paper order, beside PAPER.md, the build report rendered from it. Each part carries the version it was last made in, what its inputs hashed to then (a re-order recomposes only the parts whose inputs changed, the title and abstract whenever a main-text part did), and what its file hashed to as code wrote it, so an owner's edit of a part whose inputs did not change is kept. The previous version is frozen under research/paper/earlier/v<n>/.",
  "type": "object",
  "required": ["version", "order", "by", "commit", "composed", "model", "parts", "tables", "alternatives", "answers", "unchecked", "left_out", "proposals", "reworded", "kept_edits", "gated", "usage"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "order": {"type": "integer", "minimum": 1, "description": "the paper order that made this version"},
    "by": {"enum": ["owner", "decider"]},
    "commit": {"type": ["string", "null"], "description": "the commit of main the paper was composed from"},
    "composed": {"type": "string", "description": "when, as the journal spells a timestamp"},
    "model": {"type": ["string", "null"], "description": "the writer session's model, null when no part needed one"},
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "abstract", "introduction", "results", "discussion", "methods", "supplement", "front"],
      "properties": {
        "title": {"$ref": "#/$defs/part"}, "abstract": {"$ref": "#/$defs/part"}, "introduction": {"$ref": "#/$defs/part"},
        "results": {"$ref": "#/$defs/part"}, "discussion": {"$ref": "#/$defs/part"}, "methods": {"$ref": "#/$defs/part"},
        "supplement": {"$ref": "#/$defs/part"}, "front": {"$ref": "#/$defs/part"}
      }
    },
    "tables": {"type": "array", "items": {"type": "string", "pattern": "^S?T[1-9][0-9]*$"}, "description": "the figure plan's tables (T<n>, supplementary ST<n>) and then the writer's"},
    "figures": {
      "type": "object",
      "description": "the figure plan this version followed and its figures (ticket 116): each figure's plan line, the figure role's id and status, and the key a re-order compares to reuse a verified figure",
      "required": ["venue", "limit", "figures", "tables", "moved", "without"],
      "additionalProperties": false,
      "properties": {
        "venue": {"type": ["string", "null"]},
        "limit": {"type": ["integer", "null"], "description": "the venue's display-item limit"},
        "figures": {"type": "array", "items": {"type": "object",
          "required": ["id", "result", "main", "panels", "line", "figure_id", "key", "status", "version", "reused", "reason", "findings_for_text"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^[FS][1-9][0-9]*$"}, "result": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
            "main": {"type": "boolean"}, "panels": {"type": "array", "items": {"type": "string"}}, "line": {"type": "string"},
            "figure_id": {"type": "string"}, "key": {"type": ["string", "null"]}, "status": {"type": "string"},
            "version": {"type": ["integer", "null"]}, "reused": {"type": "boolean"}, "reason": {"type": ["string", "null"]},
            "findings_for_text": {"type": "array", "items": {"type": "string"}}
          }}},
        "tables": {"type": "array", "items": {"type": "object", "required": ["id", "result", "plot", "main"], "additionalProperties": false,
          "properties": {"id": {"type": "string", "pattern": "^S?T[1-9][0-9]*$"}, "result": {"type": "string"}, "plot": {"type": "string"},
                         "main": {"type": "boolean"}}}},
        "moved": {"type": "array", "items": {"type": "string"}},
        "without": {"type": "array", "items": {"type": "string"}}
      }
    },
    "alternatives": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]+-[1-9][0-9]*$"}},
    "answers": {
      "type": "array",
      "description": "the batch's answers the composition followed, or code's defaults where no batch was asked",
      "items": {
        "type": "object",
        "required": ["ref", "text", "mark", "by"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "pattern": "\\S"}, "text": {"type": "string"}, "mark": {"type": "string", "pattern": "\\S"},
          "by": {"enum": ["owner", "decider", "code"]}, "batch": {"type": ["string", "null"]}, "item": {"type": ["integer", "null"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "unchecked": {"enum": ["kept", "left out", null], "description": "with no inherited result verified, whether the unchecked ones were kept as stated or left out; null when one was verified or none is inherited"},
    "left_out": {"type": "array", "items": {"type": "object", "required": ["what", "why"], "additionalProperties": false,
                                             "properties": {"what": {"type": "string"}, "why": {"type": "string"}}}},
    "proposals": {"type": "array", "items": {"type": "string"}},
    "reworded": {"type": "array", "items": {"type": "string", "pattern": "^P[1-9][0-9]*$"}, "description": "the owner's passages the paper does not carry word for word"},
    "kept_edits": {"type": "array", "items": {"type": "string"}, "description": "the parts whose owner's edit was kept"},
    "gated": {"type": "boolean", "description": "false until a build's gates judged this version"},
    "code": {"type": ["object", "null"], "description": "code's steps at the order (ticket 119): the tag paper-N on main, the commit it is at, whether the code repository's split was pushed with it, and the record of the steps (research/orders/<N>/code.json); null when code took none",
             "required": ["tag", "commit", "pushed", "record"], "additionalProperties": false,
             "properties": {"tag": {"type": ["string", "null"], "pattern": "^paper-[1-9][0-9]*$"}, "commit": {"type": ["string", "null"]},
                            "pushed": {"type": "boolean"}, "record": {"type": "string"}}},
    "builds": {"type": "array", "description": "this version's builds (ticket 117), each with its three gates in order and the points each left standing",
               "items": {"type": "object", "required": ["build", "gates", "passed"], "additionalProperties": false,
                         "properties": {"build": {"type": "integer", "minimum": 1}, "passed": {"type": "boolean"},
                                        "gates": {"type": "array", "items": {"type": "object", "required": ["gate", "pass", "session_id", "model", "fallback_from", "points", "note"],
                                                                            "additionalProperties": false,
                                                                            "properties": {"gate": {"enum": ["kill_argument", "paper_read", "sampled_verdicts"]},
                                                                                           "pass": {"type": "boolean"}, "session_id": {"type": ["string", "null"]},
                                                                                           "model": {"type": ["string", "null"]}, "fallback_from": {"type": ["string", "null"]},
                                                                                           "points": {"type": "array", "items": {"type": "string"}},
                                                                                           "note": {"type": ["string", "null"]}}}}}}},
    "outcome": {"enum": [null, "passed", "not_passed"], "description": "passed once a build's gates all passed; not_passed when the last build the order allowed failed (ticket 117); null while ungated or a next build is owed"},
    "concerns_asked": {"type": "array", "items": {"type": "string", "pattern": "^K[1-9][0-9]*$"},
                       "description": "the concerns kept for the order the writer was asked about when the parts were written (ticket 117)"},
    "concerns": {"type": "array", "description": "how the writer says the paper answers each concern kept for the order (ticket 117)",
                 "items": {"type": "object", "required": ["id", "answer"], "additionalProperties": false,
                           "properties": {"id": {"type": "string", "pattern": "^K[1-9][0-9]*$"}, "answer": {"type": "string"}}}},
    "usage": {"type": ["object", "null"], "description": "the writer session's token usage, its turns, and its duration"}
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["version", "inputs", "sha256"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "integer", "minimum": 1, "description": "the version this part was last made in"},
        "inputs": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "what the part's inputs hashed to when it was made"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "the part's file as code wrote it"}
      }
    }
  }
}
