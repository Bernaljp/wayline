{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harness",
  "description": "A project's harness.json (Implementation Decisions 1): the pin, autonomy, radius, the fallback consent, budgets, reservations, pacing, notify, dashboard, policy overrides, docs theme.",
  "type": "object",
  "required": ["harness_tag", "autonomy", "radius"],
  "additionalProperties": false,
  "properties": {
    "harness_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "autonomy": {"type": "string", "enum": ["interactive", "checkpoints", "autonomous"]},
    "radius": {"type": "string", "enum": ["strict", "moderate", "exploratory"]},
    "model_fallback": {
      "type": "string",
      "enum": ["auto", "ask", "wait"],
      "description": "the fallback consent (Implementation Decisions 15): whether Fable work falls back to Opus while Fable's weekly window is spent; a project without the key behaves as ask"
    },
    "human_only": {
      "type": "array",
      "description": "the decision classes the decider never resolves (Implementation Decisions 4): goal and data always, plus the classes the owner added at intake",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_hours": {"type": ["number", "null"], "minimum": 0},
        "wallclock_hours": {"type": ["number", "null"], "minimum": 0},
        "usage_windows": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "reservations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "GPU indices kept for the owner; empty means none"},
        "cores": {"type": "integer", "minimum": 0},
        "ram_gb": {"type": "number", "minimum": 0},
        "processes": {"type": "array", "items": {"type": "string"}, "description": "process names whose GPU memory and cores count as reserved"}
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_at": {"type": "number", "minimum": 0, "maximum": 1},
        "cheap_at": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hermes_python": {"type": ["string", "null"], "description": "the interpreter that runs hermes_cli; null disables the Telegram channel"}
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "bind": {"type": "string"},
        "poll_journal_s": {"type": "number", "minimum": 0},
        "poll_views_s": {"type": "number", "minimum": 0}
      }
    },
    "policy": {"type": "object", "description": "overrides of policy.json keys, same shape"},
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {"type": "string"}
      }
    },
    "owner_email": {"type": ["string", "null"], "description": "sent in the scout's User-Agent to the polite pools"}
  }
}
