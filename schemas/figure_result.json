{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "figure_result",
  "description": "What the figure role returns for one figure_request (Implementation Decisions 13; research-notes 11 Section 4.3). Each status carries the block that justifies it: a verified figure has its final files, its machine checks, and its honesty verdict.",
  "type": "object",
  "required": ["schema", "ticket", "figure_id", "status"],
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"status": {"const": "candidates_ranked"}}, "required": ["candidates"]},
    {"properties": {"status": {"const": "selected"}}, "required": ["candidates", "selected"]},
    {"properties": {"status": {"const": "verified"}, "checks": {"minItems": 1, "items": {"properties": {"pass": {"const": true}}}}, "honesty_verdict": {"properties": {"verdict": {"const": "pass"}}}}, "required": ["final", "checks", "honesty_verdict"]},
    {"properties": {"status": {"const": "failed_checks"}}, "required": ["checks"]},
    {"properties": {"status": {"const": "honesty_failed"}, "honesty_verdict": {"properties": {"verdict": {"const": "fail"}}}}, "required": ["checks", "honesty_verdict"]},
    {"properties": {"status": {"const": "refused"}}, "required": ["refusals"]},
    {"properties": {"status": {"const": "blocked"}}}
  ],
  "properties": {
    "schema": {"const": "figure_result/1"},
    "ticket": {"type": "string", "pattern": "\\S"},
    "figure_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {
      "type": "string",
      "enum": ["candidates_ranked", "selected", "verified", "failed_checks", "honesty_failed", "refused", "blocked"]
    },
    "data_shape": {"type": "object", "description": "the shape classified in code, with the family hints it implies"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index_id", "rendered"],
        "additionalProperties": false,
        "oneOf": [
          {"properties": {"rendered": {"const": true}}},
          {"properties": {"rendered": {"const": false}}, "required": ["error"]}
        ],
        "properties": {
          "rank": {"type": ["integer", "null"], "minimum": 1},
          "index_id": {"type": "string", "pattern": "\\S", "description": "the plot index entry, or the structure index layout for a framework figure"},
          "chart_type": {"type": "string"},
          "library": {"type": "string"},
          "generator": {"type": ["string", "null"]},
          "png": {"type": ["string", "null"]},
          "rendered": {"type": "boolean"},
          "error": {"type": ["string", "null"], "description": "why the draft did not render; a candidate that failed is recorded, not hidden"},
          "pitfalls_consulted": {"type": "array", "items": {"type": "string"}},
          "score": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim_legibility": {"type": "number", "minimum": 0, "maximum": 5},
              "honesty": {"type": "number", "minimum": 0, "maximum": 5},
              "venue_fit": {"type": "number", "minimum": 0, "maximum": 5},
              "legibility_at_size": {"type": "number", "minimum": 0, "maximum": 5},
              "total": {"type": "number", "minimum": 0}
            }
          },
          "critic_reasons": {"type": "string"}
        }
      }
    },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "rubric_version": {"type": "string"}
      }
    },
    "selected": {
      "type": "object",
      "required": ["rank", "by", "margin_low"],
      "additionalProperties": false,
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "by": {"type": "string", "enum": ["human", "decider"]},
        "margin": {"type": ["number", "null"]},
        "margin_low": {"type": "boolean", "description": "true when the margin over rank 2 is below policy.figures.margin_threshold"}
      }
    },
    "final": {
      "type": "object",
      "required": ["generator", "caption", "notes", "inputs"],
      "additionalProperties": false,
      "properties": {
        "generator": {"type": "string", "pattern": "\\S", "description": "relative to the project; run from the project root, it writes pdf and png at the paths below"},
        "pdf": {"type": ["string", "null"]},
        "png": {"type": ["string", "null"]},
        "caption": {"type": "string", "pattern": "\\S"},
        "notes": {"type": "string", "pattern": "\\S"},
        "crops": {"type": "array", "items": {"type": "string"}},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "run_id"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "pattern": "\\S"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "run_id": {"type": "string", "pattern": "\\S"},
              "panels": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]$"}, "description": "the panels this input is drawn in; absent means every panel"}
            }
          }
        },
        "output_sha256": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pdf": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "png": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "description": "the report block the check runner returns: one entry per machine check",
      "items": {
        "type": "object",
        "required": ["id", "type", "pass", "tool", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"type": "string", "enum": ["A", "B"]},
          "pass": {"type": "boolean"},
          "tool": {"type": ["string", "null"]},
          "detail": {"type": "string"}
        }
      }
    },
    "honesty_verdict": {
      "type": "object",
      "required": ["type", "verdict", "findings"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "B"},
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "session": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "text"],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string",
                "enum": ["capability_not_realized", "selection_artifact", "invisible_comparison", "omitted_negative", "undisclosed_mixed_data", "equation_mismatch", "implied_claim"]
              },
              "text": {"type": "string", "pattern": "\\S"},
              "locator": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "schematic_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["panel", "element", "reason", "caption_phrase"],
        "additionalProperties": false,
        "properties": {
          "panel": {"type": "string", "pattern": "\\S"},
          "element": {"type": "string", "pattern": "\\S"},
          "reason": {"type": "string", "pattern": "\\S"},
          "caption_phrase": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "selection_statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["panel", "criterion", "displayed", "global", "tolerance"],
        "additionalProperties": false,
        "properties": {
          "panel": {"type": "string", "pattern": "\\S"},
          "criterion": {"type": "string", "pattern": "\\S"},
          "displayed": {"type": "number"},
          "global": {"type": "number"},
          "tolerance": {"type": "number", "minimum": 0}
        }
      }
    },
    "findings_for_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "pattern": "\\S"},
          "manuscript_locator": {"type": ["string", "null"]},
          "suggested_ticket": {"type": "boolean"}
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_request", "reason", "alternative_candidate", "overridden_by"],
        "additionalProperties": false,
        "properties": {
          "change_request": {"type": "string", "pattern": "\\S"},
          "reason": {"type": "string", "pattern": "\\S"},
          "alternative_candidate": {"type": ["string", "null"]},
          "overridden_by": {"type": ["string", "null"], "description": "set only by a human through the decision queue"}
        }
      }
    },
    "traps_hit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["library", "chart_type", "description", "fix", "promote_to_index"],
        "additionalProperties": false,
        "properties": {
          "library": {"type": "string", "pattern": "\\S"},
          "chart_type": {"type": "string", "pattern": "\\S"},
          "description": {"type": "string", "pattern": "\\S"},
          "fix": {"type": "string", "pattern": "\\S"},
          "promote_to_index": {"type": "boolean"}
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "session"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string", "pattern": "\\S"},
          "session": {"type": ["string", "null"]}
        }
      }
    }
  }
}
