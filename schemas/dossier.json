{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dossier",
  "$defs": {
    "name": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["doi", "arxiv", "title", "url", "file"], "description": "file: a PDF the owner gave with no identifier, never sent to a service"},
        "value": {"type": "string"},
        "raw": {"type": "string", "description": "the reference line as the owner wrote it"}
      }
    }
  },
  "description": "One reference's record (Implementation Decisions 9). Level 0 is what the scout can verify at near-zero cost: the question that was asked, the identifiers and metadata a keyless service answered with, an abstract, and whether the reference resolved at all. Levels 1 and 2 are added by the tickets that build the skim and the full absorb; a reference that resolves nowhere is existence: unresolved, and nothing here ever says fabricated.",
  "type": "object",
  "required": ["schema_version", "slug", "level", "existence", "query", "identifiers", "metadata", "created"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$", "description": "the directory under research/refs/ that holds this reference"},
    "level": {"type": "integer", "minimum": 0, "maximum": 2},
    "existence": {"type": "string", "enum": ["verified", "unresolved"]},
    "resolved_by": {
      "type": ["string", "null"],
      "enum": ["crossref", "openalex", "unpaywall", "europepmc", "arxiv", "biorxiv", "medrxiv", "owner", null],
      "description": "the service whose answer established that the work exists; owner when the owner handed over its PDF and no service knew it; null when none did"
    },
    "query": {"$ref": "#/$defs/name"},
    "names": {
      "type": "array",
      "description": "every way this work was named, the first query included: a second reference to a filed work joins it here (decision 17)",
      "items": {"$ref": "#/$defs/name"}
    },
    "notes": {
      "type": "array",
      "description": "what was said about the reference where it was named (an intake's nested remark, a ticket's note), kept on the dossier and never read by the scout",
      "items": {
        "type": "object",
        "required": ["text", "by", "ts"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string"},
          "by": {"type": "string", "description": "intake, owner, or ticket <id>"},
          "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
        }
      }
    },
    "retry": {
      "type": "object",
      "description": "set when a lookup failed on a work not found (or found only by the arXiv abs page): retried at most once a day, given up after policy.scout.give_up_days",
      "required": ["service", "failure", "date"],
      "additionalProperties": false,
      "properties": {
        "service": {"type": "string"},
        "failure": {"type": "string"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "description": "the last failed lookup"},
        "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "description": "the first failed lookup, which the give-up counts from"},
        "gave_up": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "description": "when the flag gave up; nothing retries it after"}
      }
    },
    "handed_over": {
      "type": "array",
      "description": "the owner's answers to an unresolved reference, oldest first, recorded without asking",
      "items": {
        "type": "object",
        "required": ["answer", "ts"],
        "additionalProperties": false,
        "properties": {
          "answer": {"type": "string", "enum": ["doi", "title", "pdf", "leave"]},
          "value": {"type": ["string", "null"]},
          "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
        }
      }
    },
    "joined_into": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$", "description": "a pointer: this dossier's work is the one filed under that slug, which holds its names and notes"},
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {"type": "string"},
        "arxiv_id": {"type": "string"},
        "pmid": {"type": "string"},
        "pmcid": {"type": "string"},
        "openalex": {"type": "string"},
        "published_doi": {"type": "string", "description": "the journal DOI a preprint record names once it is published"},
        "url": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}},
        "year": {"type": ["integer", "null"], "minimum": 1500, "maximum": 2200},
        "container": {"type": "string", "description": "journal, conference, or preprint server"},
        "type": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "abstract": {"type": ["string", "null"]},
    "relation_to_intent": {"type": "string", "description": "level 1 and up: one line, from the L1 record, on how the paper relates to the project's intent"},
    "deserves_l2_if": {"type": "string", "description": "level 1 and up: one line, from the L1 record, on what would earn the paper a full read"},
    "l2": {
      "type": "object",
      "description": "level 2: what the absorb workflow read, merged by code. The entries themselves are refs/<slug>/entries.jsonl and the prose is rendered to refs/<slug>/dossier.md; sections is the synthesizer's answer, validated against dossier_sections before it is written here.",
      "required": ["absorbed", "fanout", "manifest", "entries_path", "chunks", "entries", "coverage", "sections", "failures", "spot_check"],
      "additionalProperties": false,
      "properties": {
        "absorbed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
        "fanout": {"type": "string", "enum": ["workflow", "conductor"]},
        "allow_rules": {"type": ["string", "null"], "enum": ["narrow", "broad", null], "description": "workflow fan-out: whether Workflow(absorb) and Skill(absorb) sufficed, or Workflow and Skill were needed"},
        "session_ids": {"type": "array", "items": {"type": "string"}},
        "run_file": {"type": ["string", "null"], "description": "the Workflow run file the result was read from"},
        "manifest": {"type": "string"},
        "entries_path": {"type": "string"},
        "markdown_path": {"type": "string"},
        "chunks": {"type": "integer", "minimum": 0},
        "entries": {"type": "integer", "minimum": 0},
        "coverage": {
          "type": "object",
          "description": "the Type-A coverage audit: every inventory item has an entry, and every figure an entry that says what it shows",
          "required": ["pass", "items", "covered", "missing"],
          "additionalProperties": false,
          "properties": {
            "pass": {"type": "boolean"},
            "items": {"type": "integer", "minimum": 0},
            "covered": {"type": "integer", "minimum": 0},
            "missing": {"type": "array", "items": {"type": "string"}}
          }
        },
        "sections": {"type": ["object", "null"]},
        "unresolved_locators": {"type": "array", "items": {"type": "string"}},
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk", "reason", "missing"],
            "additionalProperties": false,
            "properties": {
              "chunk": {"type": ["string", "null"]},
              "reason": {"type": "string"},
              "missing": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "problems": {"type": "array", "items": {"type": "string"}},
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": {"type": ["integer", "null"], "minimum": 0},
            "tokens": {"type": ["integer", "null"], "minimum": 0},
            "duration_ms": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "spot_check": {
          "type": "object",
          "description": "the Type-B depth spot-check, queued for the critic until it is taken",
          "required": ["status", "role", "verdict_type", "author_model", "question", "scope_limit", "paths"],
          "additionalProperties": false,
          "properties": {
            "status": {"type": "string", "enum": ["queued", "passed", "failed"]},
            "role": {"type": "string"},
            "verdict_type": {"type": "string"},
            "author_model": {"type": "string"},
            "items": {"type": "array", "items": {"type": "string"}},
            "flaws": {"type": "integer", "minimum": 0},
            "question": {"type": "string"},
            "scope_limit": {"type": "string"},
            "paths": {"type": "array", "items": {"type": "string"}},
            "session_id": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]},
            "fallback_from": {"type": ["string", "null"], "description": "the Fable rung the critic came from (r7 fable high) when it ran on Opus in place of a verifier on Fable (decisions 15 and 16)"},
            "findings": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "open_access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_oa": {"type": ["boolean", "null"]},
        "pdf_url": {"type": "string"},
        "license": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "attempts": {
      "type": "array",
      "description": "every lookup the scout made, in order, whatever it answered; this is the audit trail behind existence",
      "items": {
        "type": "object",
        "required": ["source", "url", "outcome"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string", "enum": ["crossref", "openalex", "unpaywall", "europepmc", "arxiv", "biorxiv", "medrxiv", "none"]},
          "url": {"type": "string"},
          "status": {"type": ["integer", "null"]},
          "outcome": {"type": "string", "enum": ["found", "no match", "failed", "skipped"], "description": "found: the service knew the work; no match: it answered and nothing matched; failed: an error status, a timeout, or an unreadable answer; skipped: nothing was asked"},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
  }
}
