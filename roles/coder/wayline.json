{
  "role": "coder",
  "summary": "Implements one code ticket in its worktree and returns the structured result.",
  "kinds": ["code", "docs", "harness"],
  "may_judge": false,
  "output_schema": "result",
  "allowed_tools": [
    "Read", "Edit", "Write", "Glob", "Grep", "Agent",
